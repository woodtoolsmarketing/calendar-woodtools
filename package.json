{
  "name": "calendario-interactive",
  "version": "1.6.0",
  "description": "Calendario interactivo de tareas y programación de contenido para WoodTools",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publicar": "electron-builder --win --publish always"
  },
  "author": "WoodTools",
  "license": "MIT",
  "build": {
    "appId": "com.woodtools.calendario",
    "productName": "Calendario WoodTools",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "recurrence.js",
      "credentials.js",
      "tokens.js",
      "efemerides.js",
      "adsStore.js",
      "alert.html",
      "src/**/*",
      "integrations/**/*",
      "assets/**/*",
      "node_modules/fullcalendar/**/*",
      "node_modules/chart.js/dist/**/*",
      "!seed/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calendario WoodTools"
    },
    "artifactName": "Calendario-WoodTools-${version}-instalador.${ext}",
    "publish": {
      "provider": "github",
      "owner": "woodtoolsmarketing",
      "repo": "calendar-woodtools",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "electron-updater": "^6.8.11",
    "fullcalendar": "^6.1.20"
  }
}
